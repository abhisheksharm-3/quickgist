# Anon/publishable key only. The service_role key must never reach the browser.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Leave empty to use the dev proxy in vite.config.ts.
VITE_API_BASE_URL=

# Sentry (browser DSN is public by design; the Go API needs its own project)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
