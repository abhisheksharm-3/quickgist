# Server
PORT=8000
APP_ENV=development

# Supabase. DATABASE_URL must be the *pooler* string (port 6543): the direct
# db.<ref>.supabase.co host is AAAA-only and unreachable from IPv4-only networks.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PROJECT_REF=<ref>
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Storage
SUPABASE_STORAGE_BUCKET=gist-files

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Observability. Both optional; absent means disabled, not broken.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=quickgist-api
SUPABASE_PUBLISHABLE_KEY=
