#!/usr/bin/env bash
#
# quickgist — share a file or a pipe as a link.
#
#   quickgist notes.md                 # share a file, keeping its name
#   cat notes.md | quickgist           # share stdin as paste.md
#   pbpaste | quickgist -n bug.go      # name the file yourself
#   quickgist -v public notes.md       # public instead of unlisted
#   quickgist -e 7 notes.md            # delete it after 7 days
#
# The link is printed on stdout and nothing else is, so it pipes into pbcopy.
#
# QUICKGIST_API is required and is the base URL of your own deployment. There is no
# default on purpose: a wrong one would post the file you are sharing to somebody
# else's server. QUICKGIST_TOKEN is an access token, needed only for a private gist;
# without one the gist is anonymous, which is what the web editor does too.
set -euo pipefail

usage() {
	cat <<'HELP'
quickgist — share a file or a pipe as a link.

  quickgist notes.md            share a file, keeping its name
  cat notes.md | quickgist      share stdin as paste.md
  pbpaste | quickgist -n bug.go name the file yourself

  -n NAME   filename, which decides how the gist is rendered
  -v LEVEL  unlisted (default), public, or private
  -e DAYS   delete the gist after DAYS days
  -t TITLE  title, defaulting to the filename

QUICKGIST_API is required and is the base URL of your own deployment. There is no
default on purpose: a wrong one would post the file you are sharing to somebody
else's server. QUICKGIST_TOKEN signs the gist as you, needed only for private.
HELP
}

filename=""
visibility="unlisted"
expires=""
title=""

while getopts ':n:v:e:t:h' option; do
	case "$option" in
	n) filename="$OPTARG" ;;
	v) visibility="$OPTARG" ;;
	e) expires="$OPTARG" ;;
	t) title="$OPTARG" ;;
	h)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
done
shift $((OPTIND - 1))

API="${QUICKGIST_API:-}"
if [ -z "$API" ]; then
	echo "quickgist: set QUICKGIST_API to your deployment, for example https://quickgist.onrender.com" >&2
	exit 2
fi

source_file="${1:--}"
if [ "$source_file" != "-" ] && [ -z "$filename" ]; then
	filename="$(basename -- "$source_file")"
fi

query="visibility=$visibility"
[ -n "$filename" ] && query="$query&filename=$filename"
[ -n "$expires" ] && query="$query&expires=$expires"
[ -n "$title" ] && query="$query&title=$title"

# --data-binary keeps the bytes as they are; --data would strip the newlines, which
# matters for Markdown, where a blank line is a paragraph break.
curl --fail-with-body --silent --show-error \
	--request POST \
	--header 'Content-Type: text/plain' \
	${QUICKGIST_TOKEN:+--header "Authorization: Bearer $QUICKGIST_TOKEN"} \
	--data-binary "@$source_file" \
	"$API/v1/paste?$query"
